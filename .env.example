# =============================================================================
# MERIDIAN HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# Never commit active secrets, credentials, or production tokens to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & DEMO MODE CONFIGURATION
# -----------------------------------------------------------------------------
# Enables fictional demonstration accounts, 1-click access buttons on the login
# page, and authorized demo dataset reset mechanisms.
# Set to 'false' for production deployments to disable all demo controls.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# -----------------------------------------------------------------------------
# Cryptographic secret key used to sign session cookies and HMAC tokens.
# IN PRODUCTION: Generate a high-entropy 64-character random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
MERIDIAN_SECRET_KEY=replace-with-a-secure-random-hex-string-for-production

# Require HTTPS for session cookies ('true' in production with SSL/TLS).
# When set to 'true', cookies will only be transmitted over encrypted HTTPS.
# Leave 'false' for local development on http://127.0.0.1.
SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# 3. DATABASE & STORAGE
# -----------------------------------------------------------------------------
# Path to SQLite database file. Defaults to 'backend/meridian.db'.
# In production, ensure this path resides on persistent, backed-up storage.
MERIDIAN_DB_PATH=backend/meridian.db

# -----------------------------------------------------------------------------
# 4. NETWORK & CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# For production, specify your exact domain: e.g., https://meridian.health.gov
# Use '*' for local testing.
ALLOWED_ORIGINS=*

# Server host and port configuration
HOST=127.0.0.1
PORT=8000
